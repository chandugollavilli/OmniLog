datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum RoleName {
  ADMINISTRATOR
  SOC_ANALYST
  AUDITOR
  VIEWER
}

enum AlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum IncidentStatus {
  NEW
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
}

enum ReportType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

model Organization {
  id          String   @id @default(uuid())
  name        String   @unique
  domain      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sites       Site[]
  users       User[]
  devices     Device[]
  logs        FirewallLog[]
  alerts      Alert[]
  alertRules  AlertRule[]
  incidents   Incident[]
  cases       Case[]
}

model Site {
  id             String       @id @default(uuid())
  name           String
  location       String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  devices        Device[]
  users          User[]
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  username       String       @unique
  passwordHash   String
  role           RoleName     @default(VIEWER)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  siteId         String?
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  isActive       Boolean      @default(true)
  failedAttempts Int          @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sessions       Session[]
  auditLogs      AuditLog[]
  assignedCases  Case[]       @relation("AssignedAnalyst")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Device {
  id              String        @id @default(uuid())
  name            String
  vendor          String        @default("Fortinet")
  serialNumber    String        @unique
  ipAddress       String
  model           String
  firmwareVersion String
  vdom            String        @default("root")
  location        String?
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  siteId          String?
  site            Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  status          String        @default("ONLINE")
  logsPerSec      Float         @default(0.0)
  lastSeenAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  logs            FirewallLog[]
}

model Collector {
  id          String   @id @default(uuid())
  name        String   @unique
  vendor      String
  protocol    String
  port        Int
  status      String   @default("RUNNING")
  logsCount   BigInt   @default(0)
  createdAt   DateTime @default(now())
}

model FirewallLog {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  deviceId       String?
  device         Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  vendor         String        @default("fortigate")
  timestamp      DateTime      @default(now())
  devname        String?
  devid          String?
  logid          String?
  type           String?
  subtype        String?
  level          String?
  vd             String?
  srcip          String?
  dstip          String?
  srcport        Int?
  dstport        Int?
  proto          Int?
  action         String?
  policyid       Int?
  polname        String?
  user           String?
  srcintf        String?
  dstintf        String?
  sentbyte       BigInt?       @default(0)
  rcvdbyte       BigInt?       @default(0)
  duration       Int?          @default(0)
  app            String?
  service        String?
  sessionid      BigInt?
  tranip         String?
  trport         Int?
  srccountry     String?
  dstcountry     String?
  city           String?
  latitude       Float?
  longitude      Float?
  asn            String?
  url            String?
  threat         String?
  mitreTactic    String?
  mitreTechnique String?
  msg            String?
  raw            String

  @@index([timestamp(sort: Desc)])
  @@index([srcip])
  @@index([dstip])
  @@index([action])
  @@index([type])
  @@index([devname])
  @@index([vendor])
}

model AlertRule {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  eventType      String
  severity       AlertSeverity @default(MEDIUM)
  condition      String
  threshold      Int           @default(1)
  windowMins     Int           @default(5)
  channels       String        @default("EMAIL,WEBHOOK")
  webhookUrl     String?
  slackUrl       String?
  teamsUrl       String?
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  alerts         Alert[]
}

model Alert {
  id             String                @id @default(uuid())
  organizationId String?
  organization   Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ruleId         String?
  rule           AlertRule?            @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  title          String
  description    String
  severity       AlertSeverity
  status         AlertStatus           @default(OPEN)
  sourceIp       String?
  destIp         String?
  details        String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  notifications  NotificationHistory[]
  incidents      Incident[]

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([severity])
}

model Incident {
  id             String          @id @default(uuid())
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  alertId        String?
  alert          Alert?          @relation(fields: [alertId], references: [id], onDelete: SetNull)
  title          String
  description    String
  severity       AlertSeverity   @default(HIGH)
  status         IncidentStatus  @default(NEW)
  mitreTactic    String?
  mitreTechnique String?
  assignedTo     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  cases          Case[]
  timeline       TimelineEvent[]

  @@index([createdAt(sort: Desc)])
  @@index([status])
}

model Case {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  incidentId     String
  incident       Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  priority       String        @default("MEDIUM")
  analystId      String?
  analyst        User?         @relation("AssignedAnalyst", fields: [analystId], references: [id], onDelete: SetNull)
  slaMinutes     Int           @default(240)
  tags           String?
  status         String        @default("OPEN")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  evidence       Evidence[]
  comments       Comment[]
}

model Evidence {
  id          String   @id @default(uuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileType    String
  description String?
  uploadedAt  DateTime @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author    String
  text      String
  createdAt DateTime @default(now())
}

model TimelineEvent {
  id          String   @id @default(uuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  action      String
  actor       String?
  description String
  timestamp   DateTime @default(now())
}

model SigmaRule {
  id             String   @id @default(uuid())
  name           String
  yamlContent    String
  status         String   @default("ENABLED")
  mitreTactic    String?
  mitreTechnique String?
  hitCount       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ThreatFeed {
  id        String   @id @default(uuid())
  name      String
  iocType   String
  iocValue  String   @unique
  severity  String   @default("HIGH")
  sourceUrl String?
  updatedAt DateTime @updatedAt
}

model Playbook {
  id          String   @id @default(uuid())
  name        String
  triggerEvent String
  actions     String
  enabled     Boolean  @default(true)
  runCount    Int      @default(0)
  createdAt   DateTime @default(now())
}

model DashboardWidget {
  id        String   @id @default(uuid())
  userId    String
  title     String
  type      String
  positionX Int      @default(0)
  positionY Int      @default(0)
  width     Int      @default(6)
  height    Int      @default(4)
}

model NotificationHistory {
  id        String   @id @default(uuid())
  alertId   String
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel   String
  target    String
  status    String
  error     String?
  sentAt    DateTime @default(now())
}

model Report {
  id          String     @id @default(uuid())
  title       String
  type        ReportType
  startDate   DateTime
  endDate     DateTime
  fileUrl     String
  format      String
  generatedBy String?
  createdAt   DateTime   @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model Settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String   @default("SYSTEM")
  description String?
  updatedAt   DateTime @updatedAt
}

model HealthMetrics {
  id           String   @id @default(uuid())
  cpuUsage     Float
  ramUsage     Float
  diskUsage    Float
  queueSize    Int
  logsPerSec   Float
  dbLatencyMs  Float
  activeSocket Int
  recordedAt   DateTime @default(now())

  @@index([recordedAt(sort: Desc)])
}
