# OmniLog Environment Configuration

# Application
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# Security & JWT
JWT_SECRET=omnilog_super_secret_jwt_key_32_chars_min!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=omnilog_super_secret_refresh_token_key!
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# Database (PostgreSQL)
DATABASE_URL=postgresql://omnilog:omnilog_secure_pass@postgres:5432/omnilog_db?schema=public

# Syslog Receiver Settings
SYSLOG_UDP_PORT=5140
SYSLOG_TCP_PORT=5140
SYSLOG_TLS_PORT=6514
SYSLOG_MAX_QUEUE_SIZE=50000
SYSLOG_BATCH_FLUSH_MS=500

# Mail / Webhook Alerts
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=alerts@omnilog.local
